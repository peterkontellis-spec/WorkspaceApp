# All values are server-only. Never prefix secrets with NEXT_PUBLIC_.
# pnpm db:start creates ignored .local/database.env and .local/auth.env.
# pnpm dev:db loads both. Accounts mode fails closed if configuration is absent.
WORKSPACE_MODE=accounts
AUTH_BASE_URL=http://127.0.0.1:3100
# AUTH_SECRET=generate-a-private-random-secret-of-at-least-32-characters
# DATABASE_URL=postgresql://app_user:replace_me@127.0.0.1:55432/workspace_development
# Use pnpm dev:prototype only for the explicit sample-only, unauthenticated mode.
# HTTPS and Secure cookies are required outside loopback development.
